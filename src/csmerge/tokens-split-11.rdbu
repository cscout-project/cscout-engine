# Original:  abcd|e  ... abcd|fg   (the abcd parts share one EC)
# Attached:  ab|cde  ... ab|cdfg
# Homogenizing the first identifier splits the original's abcd EC into
# ab|cd at both locations.  When the second identifier is then processed
# its first ECs (ab) match, but the remainder (cd vs cdfg) must still
# be homogenized.
BEGIN SETUP
tokens:
fid	foffset	eid
1	0	1000
1	4	1004
1	10	1000
1	14	1014

ids:
eid	name
1000	abcd
1004	e
1014	fg

adb.tokens:
fid	foffset	eid
2	0	100
2	2	102
2	10	100
2	12	112

adb.ids:
eid	name
100	ab
102	cde
112	cdfg

# Map from adjusted local fid to consolidated global fid
fileid_to_global_map:
dbid	fid	global_fid
2	1	1
5	2	1
5	9	2
END

# Provide empty but required tables.
INCLUDE CREATE empty-functionid.sql
INCLUDE CREATE empty-idproj.sql

# Extend ids with all their fields
INCLUDE CREATE extend-ids.sql

INCLUDE CREATE eclasses.sql

# Use predictable eids to compare results
INCLUDE SELECT predictable-token-eids.sql

BEGIN RESULT
fid	foffset	eid
1	0	0
1	2	1
1	4	2
1	10	0
1	12	1
1	14	3
END
